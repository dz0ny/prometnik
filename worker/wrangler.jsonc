{
  // Edge cache for webcam images. The app calls
  // https://prometnik-cams.dz0ny.workers.dev/cam?u=<encoded camera URL>
  "name": "prometnik-cams",
  "main": "src/index.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Hourly webcam history (see src/snapshots.js): each run snapshots one
  // sixtieth of the cameras, so every camera gets one frame per hour.
  "triggers": { "crons": ["* * * * *"] },
  // Frames expire via a bucket lifecycle rule (2 days).
  "r2_buckets": [{ "binding": "SNAPS", "bucket_name": "prometnik-cams" }],
  // The website (../site, Astro) is served as static assets by this same
  // Worker on prometnik.dz0ny.dev: a request whose path matches a file gets
  // the file; everything else (/cam, /history, /snap, /status, /weather)
  // falls through to src/index.js. Build the site before deploying:
  // (cd ../site && bun install && bun run build)
  "routes": [{ "pattern": "prometnik.dz0ny.dev", "custom_domain": true }],
  "assets": {
    "directory": "../site/dist/client",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
