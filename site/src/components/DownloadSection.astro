---
import { Smartphone, Apple, Store, Download } from "lucide-react";
import { LATEST_APK_URL, RELEASES_URL } from "@/lib/site";

// At launch: set these once the listings are public. While null, the card
// shows "Kmalu" and links nowhere.
const PLAY_URL: string | null = null;
const APP_STORE_URL: string | null = null;

// Closed test on Google Play (same links as lib/config/testing.dart).
const TESTERS_GROUP_URL = "https://groups.google.com/g/prometnik-testers";
const PLAY_OPT_IN_URL = "https://play.google.com/apps/testing/dev.dz0ny.promet";
---

<section id="prenos" class="py-section scroll-mt-16" aria-labelledby="prenos-naslov">
  <div class="container-page">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <h2 id="prenos-naslov" class="font-display text-4xl font-black leading-tight sm:text-5xl lg:col-span-7">
        Namestite Prometnik.
      </h2>
      <p class="text-lg text-muted-foreground lg:col-span-5">
        Za Android je na voljo kot datoteka APK ali v Googlu Play kot zaprti preizkus. App Store pride kmalu.
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-12">
      <article class="flex flex-col justify-between rounded-xl border border-primary/40 bg-card p-8 lg:col-span-7 lg:row-span-2 lg:p-10" data-reveal>
        <div>
          <Smartphone className="size-8 text-primary" aria-hidden="true" />
          <h3 class="mt-5 text-3xl font-extrabold">Android</h3>
          <p class="mt-3 max-w-md text-muted-foreground">
            Na telefonu prenesite APK zadnje izdaje z GitHuba in ga odprite. Ob prvi namestitvi Android vpraša, ali dovolite namestitev iz brskalnika.
            Potem se aplikacija posodablja sama: ko izide nova različica, jo ponudi v aplikaciji.
          </p>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={LATEST_APK_URL}
            class="inline-flex h-13 whitespace-nowrap items-center justify-center gap-2.5 rounded-full bg-primary px-7 font-bold text-primary-foreground transition-[transform,background-color] hover:-translate-y-0.5 hover:bg-primary-hover active:scale-[0.98]"
          >
            <Download className="size-5" aria-hidden="true" />
            Prenesi APK
          </a>
          <a href={RELEASES_URL} class="inline-flex h-13 whitespace-nowrap items-center justify-center rounded-full px-5 text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
            Vse izdaje
          </a>
        </div>
      </article>

      <article class="rounded-xl border border-border bg-card p-7 lg:col-span-5" data-reveal>
        <Store className="size-6 text-sky" aria-hidden="true" />
        <h3 class="mt-4 text-xl font-bold">Google Play</h3>
        {PLAY_URL ? (
          <a href={PLAY_URL} class="mt-2 inline-block text-primary underline underline-offset-4">Odpri v trgovini</a>
        ) : (
          <>
            <p class="mt-2 text-[0.97rem] text-muted-foreground">
              <span class="mr-2 inline-block rounded-full bg-muted px-2.5 py-0.5 text-sm font-bold text-foreground">Zaprti preizkus</span>
              Prometnik je v Googlu Play na voljo preizkuševalcem. Posodablja se prek trgovine.
            </p>
            <ol class="mt-4 space-y-3 text-[0.97rem]">
              <li class="flex gap-3">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary/15 text-sm font-bold text-primary">1</span>
                <span>
                  Z Google računom, ki ga uporabljate na telefonu, se pridružite skupini
                  <a href={TESTERS_GROUP_URL} class="font-semibold text-primary underline underline-offset-4">prometnik-testers</a>.
                </span>
              </li>
              <li class="flex gap-3">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary/15 text-sm font-bold text-primary">2</span>
                <span>
                  Odprite <a href={PLAY_OPT_IN_URL} class="font-semibold text-primary underline underline-offset-4">stran za preizkuševalce v Googlu Play</a>,
                  tapnite »Postani preizkuševalec« in nato prenesite aplikacijo iz trgovine.
                </span>
              </li>
            </ol>
            <p class="mt-3 text-sm text-muted-foreground">
              Če ste aplikacijo že namestili kot APK, jo najprej odstranite: različici iz trgovine in z GitHuba se ne posodabljata ena čez drugo.
            </p>
          </>
        )}
      </article>

      <article class="rounded-xl border border-border bg-card p-7 lg:col-span-5" data-reveal>
        <Apple className="size-6 text-sky" aria-hidden="true" />
        <h3 class="mt-4 text-xl font-bold">iPhone in iPad</h3>
        {APP_STORE_URL ? (
          <a href={APP_STORE_URL} class="mt-2 inline-block text-primary underline underline-offset-4">Odpri v App Storu</a>
        ) : (
          <p class="mt-2 text-[0.97rem] text-muted-foreground"><span class="mr-2 inline-block rounded-full bg-muted px-2.5 py-0.5 text-sm font-bold text-foreground">Kmalu</span>V App Storu.</p>
        )}
      </article>
    </div>
  </div>
</section>
