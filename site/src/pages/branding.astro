---
// Living style guide (not linked from navigation, noindex, not in the sitemap).
import Layout from "@/layouts/Layout.astro";
import { Download } from "lucide-react";

const swatches = [
	{ name: "background", hex: "#08111f", role: "60 % — stran", cls: "bg-background" },
	{ name: "card", hex: "#0f1b2d", role: "površina 1", cls: "bg-card" },
	{ name: "muted", hex: "#1a283d", role: "površina 2", cls: "bg-muted" },
	{ name: "border", hex: "#2a3a52", role: "črte", cls: "bg-border" },
	{ name: "sky-deep", hex: "#1b3a5b", role: "30 % — polnila, ne za tekst", cls: "bg-sky-deep" },
	{ name: "sky", hex: "#5da9e9", role: "podatki, ikone, moder tekst", cls: "bg-sky" },
	{ name: "primary", hex: "#ffb547", role: "10 % — CTA, ključne številke", cls: "bg-primary" },
	{ name: "foreground", hex: "#eef2f7", role: "tekst", cls: "bg-foreground" },
	{ name: "muted-foreground", hex: "#a9b6c8", role: "telo besedila", cls: "bg-muted-foreground" },
	{ name: "faint", hex: "#8593a8", role: "meta tekst", cls: "bg-faint" },
];
---

<Layout title="Slog" noindex={true}>
  <div class="container-page py-section space-y-20">
    <section>
      <h1 class="font-display text-6xl font-black">Nočna cesta</h1>
      <p class="mt-3 max-w-xl text-muted-foreground">Slog spletne strani Prometnik. Temna mornariška modra iz ikone, nebesno modra za podatke, en signalno oranžen poudarek. Overpass + Overpass Mono.</p>
      <div class="lane-dash mt-8 w-64" aria-hidden="true"></div>
    </section>

    <section>
      <h2 class="font-display text-3xl font-black">Barve</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {swatches.map((s) => (
          <li class="rounded-lg border border-border bg-card p-3">
            <div class:list={["h-20 rounded-md border border-border", s.cls]}></div>
            <p class="mt-3 font-bold">{s.name}</p>
            <p class="font-mono text-sm text-faint">{s.hex}</p>
            <p class="text-sm text-muted-foreground">{s.role}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="space-y-4">
      <h2 class="font-display text-3xl font-black">Tipografija</h2>
      <p class="font-display text-7xl font-black leading-none">Zapora na A1</p>
      <p class="font-display text-5xl font-black">Naslov H2 — Čez Šentilj, žled</p>
      <p class="font-display text-2xl font-extrabold">Naslov H3 — Stanje cestišča</p>
      <p class="max-w-2xl text-muted-foreground">Telo besedila (Overpass 400, 17 px): Kamere vremenskih postaj shranijo po en posnetek na uro. Šumniki: č š ž Č Š Ž.</p>
      <p class="font-mono text-3xl font-bold text-sky">−2,0 °C · 38 min · +7 min</p>
    </section>

    <section class="flex flex-wrap gap-4">
      <a href="#" class="inline-flex h-13 items-center gap-2.5 rounded-full bg-primary px-7 font-bold text-primary-foreground hover:bg-primary-hover"><Download className="size-5" aria-hidden="true" />Primarni gumb</a>
      <a href="#" class="inline-flex h-13 items-center rounded-full border border-border px-6 font-semibold hover:bg-card">Sekundarni gumb</a>
      <span class="inline-block self-center rounded-full bg-muted px-2.5 py-0.5 text-sm font-bold">Kmalu</span>
    </section>
  </div>
</Layout>
